    <color name="widget_normal_bg">#052e16</color>
    <color name="widget_normal_text">#86efac</color>
    <color name="widget_warning_bg">#1a120a</color>
    <color name="widget_warning_text">#fbbf24</color>
    <color name="widget_danger_bg">#2d0a0a</color>
