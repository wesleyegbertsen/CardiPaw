<?xml version="1.0" encoding="utf-8"?>
<!-- One pet in the all-pets widget (WidgetRows.ROW_DP high), and in its picker preview.
     WidgetUpdater.pet() sets every id below; widget_pet.xml and widget_pet_small.xml have the
     same ids. Only RemoteViews-safe views (LinearLayout, FrameLayout, TextView). Colours come
     from colors.xml (values-night for dark mode), never from code. A smaller avatar than the
     single-pet widget's, so both lines fit in 52dp. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/initial"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_avatar"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="@color/widget_avatar_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="@string/widget_preview_initial" />

        <TextView
            android:id="@+id/name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="@string/widget_preview_name" />

        <TextView
            android:id="@+id/rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="15sp"
            android:text="@string/widget_preview_rate" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- The status as text, not colour only. One view per status: the shown one is picked. -->
        <TextView
            android:id="@+id/badge_normal"
            style="@style/WidgetBadge"
            android:background="@drawable/widget_badge_normal"
            android:textColor="@color/widget_normal_text"
            android:text="@string/widget_preview_status" />

        <TextView
            android:id="@+id/badge_warning"
            style="@style/WidgetBadge"
            android:background="@drawable/widget_badge_warning"
            android:textColor="@color/widget_warning_text"
            android:visibility="gone" />

        <TextView
            android:id="@+id/badge_danger"
            style="@style/WidgetBadge"
            android:background="@drawable/widget_badge_danger"
            android:textColor="@color/widget_danger_text"
            android:visibility="gone" />

        <TextView
            android:id="@+id/trend"
            style="@style/WidgetBadge"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_badge_warning"
            android:textColor="@color/widget_warning_text"
            android:visibility="gone" />

        <TextView
            android:id="@+id/age"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_muted"
            android:textSize="13sp"
            android:text="@string/widget_preview_age" />

        <!-- The age after 3 days, in the warning colour (useLastMeasured's isStale). -->
        <TextView
            android:id="@+id/age_stale"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_stale"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
