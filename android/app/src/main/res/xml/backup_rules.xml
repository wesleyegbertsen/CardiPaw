<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and lower (API < 31): back up nothing, matching allowBackup="false" and
    data_extraction_rules.xml. The in-app export (Settings > Export data) is the only backup.
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
