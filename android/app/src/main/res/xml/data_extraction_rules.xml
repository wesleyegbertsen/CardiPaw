<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+): back up nothing and transfer nothing to a new device.
    CardiPaw keeps all data on this device (the privacy text says nothing leaves it), so the
    in-app export (Settings > Export data) is the only backup. allowBackup="false" alone does
    not stop device-to-device transfer on Android 12+; these rules do.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
