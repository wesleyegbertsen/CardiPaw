<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Backups and PDF reports, shared from cache/exports/ (EXPORTS_DIR in
         src/services/nativeFile.ts; keep the two in step). Only that folder is shared, not the
         rest of the cache, which belongs to the WebView.
         A camera capture from <input capture> would also need an external-files-path entry. -->
    <cache-path name="exports" path="exports/" />
</paths>
