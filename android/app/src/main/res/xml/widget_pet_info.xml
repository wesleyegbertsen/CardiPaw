<?xml version="1.0" encoding="utf-8"?>
<!-- The single-pet widget. Home screen only: the pet's name and rate never show on the lock
     screen. The midnight alarm and the clock and time zone broadcasts keep the age right;
     updatePeriodMillis (12 hours) only bounds how stale the widget gets in case the alarm was
     cancelled. A reconfigurable widget picks its pet again on API 31+. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.cardipaw.app.widget.WidgetConfigureActivity"
    android:description="@string/widget_pet_description"
    android:initialLayout="@layout/widget_message"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:previewLayout="@layout/widget_pet"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:updatePeriodMillis="43200000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
