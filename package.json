    "chart.js": "^4.4.0",
    "country-flag-icons": "^1.6.19",
    "dompurify": "^3.4.17",
    "idb": "^8.0.0",
    "jspdf": "^4.2.1",
    "pinia": "^2.2.0",
    "uuid": "^14.0.0",
    "vue": "^3.5.0",
    "vue-chartjs": "^5.3.0",
    "vue-i18n": "^11.4.16",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
