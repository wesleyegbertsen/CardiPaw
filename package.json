    "happy-dom": "^18.0.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.0.0"
